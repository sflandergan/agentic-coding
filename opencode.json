  "default_agent": "build",
  "permission": {
    "bash": {
      "*": "ask",

      "mkdir .temp": "allow",
      "mkdir .temp/*": "allow",
      "mkdir -p .temp": "allow",
      "mkdir -p .temp/*": "allow",

      "*>*": "ask",
      "*<*": "ask",

