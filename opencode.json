    "glob": "allow",
    "read": {
      "*": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": {
      "~/.local/share/opencode/tool-output/**": "allow",
      "~/.claude/skills/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/skills/**": "allow",
      "/var/**": "deny"
