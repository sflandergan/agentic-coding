{
  "provider": {
    "mistral-3rd-party": {
      "name": "Mistral 3rd-party (V1 compatibility)",
      "npm": "@ai-sdk/openai-compatible",
      "env": [
        "MISTRAL_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.mistral.ai/v1"
      },
      "models": {
        "zai-glm-5-3": {
          "name": "GLM 5.3 (Mistral)",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "temperature": true,
          "tool_call": true,
          "attachment": false,
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache_read": 0.14
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "zai-glm-5-3-flash": {
