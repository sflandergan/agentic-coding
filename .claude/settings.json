{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Grep(./**)",
      "Glob(./**)",
      "Read(./**)",

      "Edit(./**)",
      "Write(./**)",

      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git grep:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git rebase:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git pull)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(test:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)",

      "Bash(shellcheck:*)",
      "Bash(bash -n:*)",
      "Bash(codespell:*)",
      "Bash(bats:*)",
      "Bash(bash scripts/init.sh:*)",
      "Bash(bash scripts/copy.sh:*)",
      "Bash(bash scripts/validate-release.sh:*)",
      "Bash(bash scripts/test-installer.sh:*)",
      "Bash(ln -s ../../.agents/skills/:*)",

      "Bash(bash scripts/publish-branch.sh:*)",
      "Bash(scripts/publish-branch.sh:*)",
      "Bash(bash .agents/skills/github-pr-comments/scripts/fetch-pr-comments.sh:*)",
      "Bash(bash .agents/skills/finish/scripts/publish-and-ready.sh)",
      "Bash(bash .agents/skills/finish/scripts/ensure-fresh.sh:*)",
      "Bash(bash .agents/skills/git-publish/scripts/publish-branch.sh:*)",

      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh search issues:*)",
      "Bash(gh repo view:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(rm:*)",
      "Bash(npx skills:*)",
      "Bash(bash .agents/skills/github-pr-comments/scripts/reply-to-pr-comment.sh:*)"
    ],
    "deny": [
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)"
    ]
  }
}
